# Contraseña de Postgres (la usa el docker-compose para crear la base y conectar la app).
POSTGRES_PASSWORD=cambiame

# Opcional: claves VAPID propias. Si no se ponen, se generan solas en el primer arranque
# y quedan guardadas en la base. Para generarlas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que se manda a los servicios de push (Google, Mozilla, Apple).
VAPID_EMAIL=tu-mail@ejemplo.com

# Solo para correr con `pnpm dev` fuera de Docker:
# DATABASE_URL=postgres://orion:cambiame@localhost:5432/orion
